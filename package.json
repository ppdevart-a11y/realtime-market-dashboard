{
  "name": "realtime-market-dashboard",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "wasm:build": "wasm-pack --log-level warn build wasm/market-sim --target web --release --no-pack --out-dir pkg",
    "prestart": "npm run wasm:build",
    "start": "ng serve",
    "prebuild": "npm run wasm:build",
    "build": "ng build",
    "pretest": "npm run wasm:build",
    "test": "ng test --watch=false",
    "pretest:watch": "npm run wasm:build",
    "test:watch": "ng test",
    "pretest:coverage": "npm run wasm:build",
    "test:coverage": "ng test --watch=false --coverage",
    "test:rust": "cargo test --manifest-path wasm/market-sim/Cargo.toml",
    "prelint": "npm run wasm:build",
    "lint": "ng lint && stylelint \"src/**/*.scss\"",
    "lint:rust": "cargo fmt --manifest-path wasm/market-sim/Cargo.toml --check && cargo clippy --manifest-path wasm/market-sim/Cargo.toml --all-targets -- -D warnings",
    "pretypecheck": "npm run wasm:build",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.worker.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run lint:rust && npm run typecheck && npm test && npm run test:rust && npm run build"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": "^24.15.0"
  }
}
